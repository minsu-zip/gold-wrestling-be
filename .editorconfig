# 에디터(IntelliJ / VS Code)와 ktlint 가 같은 규칙을 보게 하는 단일 출처.
# ktlint 는 전용 설정 파일이 없고 이 파일을 읽는다 — Prettier 의 .prettierrc 자리.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4
max_line_length = 140
# ktlint 1.x 기본 스타일. 생성자·함수 파라미터를 한 줄씩 + 끝쉼표로 두어
# 파라미터 추가 시 diff 가 "1줄 추가"로 끝난다 (decisions.md D-022)
ktlint_code_style = ktlint_official
# IntelliJ 자동 포맷이 ktlint 와 같은 결과를 내도록 맞춘다 (끝쉼표 허용)
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml,json}]
indent_size = 2

[*.sql]
indent_size = 2

[*.md]
# 마크다운은 줄 끝 공백 2개가 줄바꿈 문법이므로 제거하지 않는다
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
