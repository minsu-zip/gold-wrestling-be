# 이 파일을 복사해 .env를 만들고 실제 값을 채운다: cp .env.example .env
# 실제 값은 절대 커밋하지 말 것. 새 환경변수 추가 시 이 파일에 키 이름을 함께 추가한다.
#
# .env는 두 곳에서 함께 쓰인다.
#   1) docker-compose: DB_NAME / DB_USERNAME / DB_PASSWORD / DB_PORT 로 Postgres 컨테이너를 만든다
#   2) 애플리케이션: application.yml의 spring.config.import 가 이 파일을 읽는다
# 값에 # 을 쓰면 주석으로 잘리고 \ 는 이스케이프로 처리된다(properties 포맷). 따옴표로 감싸지 말 것.

# --- DB 접속 정보 (PostgreSQL) ---
# 로컬은 docker-compose 기준 아래 값 그대로 사용 가능. DB_PASSWORD만 직접 채운다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gold_wrestling
DB_USERNAME=gold
DB_PASSWORD=

# --- 서버 ---
SERVER_PORT=8080
# 서버 기준 시간대 (Asia/Seoul 고정. 변경하지 말 것)
TZ=Asia/Seoul

# --- JWT ---
# 서명용 시크릿. 최소 32바이트 이상 (HS256 대칭키). 예: openssl rand -base64 48
JWT_SECRET=
# 토큰 만료 시간 (예: 액세스 토큰 분 단위)
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=
JWT_REFRESH_TOKEN_EXPIRY_DAYS=

# --- 카카오 OAuth ---
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# --- CORS ---
# 허용할 프론트엔드 오리진 (쉼표 구분, 예: 로컬 dev 서버 + 배포 도메인)
# FE dev 5180 / preview 5181 고정 (decisions.md D-012)
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5181

# --- 관리자 시드 (D-038) ---
# 셋 다 비워 두면 기동 시 관리자 시드를 건너뛴다. 값을 채우면 login_id가 없을 때만 멱등 생성한다.
ADMIN_SEED_LOGIN_ID=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# --- 배치 (D-116) ---
# 2주 미사용 차감 cron(매일 04:00 Asia/Seoul)의 킬 스위치. 비우면 기본값 true(=켜짐).
# false 로 두면 스케줄러 빈이 등록되지 않는다 — 관리자 수동 실행 API는 이 값과 무관하게 동작한다.
#
# ⚠️ Phase 6(출석) 전까지는 반드시 false 로 둔다 (05-REVIEW.md CR-03, D-119).
# 기준일 후보 ①(마지막 출석일)이 Phase 6까지 항상 null이라, 저녁반에만 나오는 SESSION_PASS 회원은
# 활동의 유일한 증거(EVENING_HALF 수동 차감)를 기준일로 인정받지 못한다. cron을 켜 두면 매일
# 체육관에 나오는 회원이 2주마다 1.0회씩 부당하게 추가 차감된다 — policies §4.3의 취지에 정면으로
# 어긋난다. Phase 6이 출석 기록을 채운 뒤 true 로 되돌린다.
BATCH_INACTIVITY_SCHEDULER_ENABLED=false
# 정책 시행일 하한 (yyyy-MM-dd). 이 날짜 이전의 미사용은 차감 부채로 치지 않는다. 비우면 기본값 2026-09-01 (D-119)
BATCH_INACTIVITY_POLICY_EFFECTIVE_DATE=
# 배치 1회 실행에서 회원 1명당 최대 차감 횟수. 비우면 기본값 1 (D-119)
BATCH_INACTIVITY_MAX_DEDUCTIONS_PER_RUN=
# 이 시간을 넘긴 실행 중(RUNNING) 이력은 죽은 실행으로 보고 정리한다 (예: 30m, 1h). 비우면 기본값 30m (D-117)
BATCH_INACTIVITY_STALE_RUN_TIMEOUT=

# --- 기본 지점 (D-047) ---
# 신규 회원(카카오 가입) 자동 배정 지점명. MVP는 송파점 1개.
DEFAULT_BRANCH_NAME=송파점
