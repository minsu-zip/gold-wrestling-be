# ============================================================================
# 운영 리버스 프록시 (INFRA-04, D-19, D-20) — 07-03-PLAN.md
#
# 서버 배치 경로: /opt/gold-wrestling/Caddyfile (D-18)
# {$DOMAIN}/{$ACME_EMAIL} 은 서버의 .env 에서만 실값이 채워진다. 이 파일 자체에는 실도메인·실이메일을
# 절대 하드코딩하지 않는다.
# ============================================================================
{
	email {$ACME_EMAIL}
}

# {$DOMAIN:localhost} — DOMAIN 이 비어 있으면 localhost 로 떨어져 로컬 검증이 가능하다 (D-05/D-19).
# 사이트 주소에 http:// 접두를 붙이지 않는다 — 붙이면 자동 HTTPS(및 80→443 리다이렉트)가 꺼진다.
# 호스트가 있는 사이트 주소는 그 자체로 자동 HTTPS가 기본 동작이라 별도 auto_https 지시어를 켜지 않는다.
# (설정이 없는 것 자체가 의도다 — 나중에 "왜 없지?"라고 의심하지 말 것)
{$DOMAIN:localhost} {
	# 매처 선언 순서가 의미를 가진다 — respond 가 reverse_proxy 보다 먼저 선언돼야 이 경로에서
	# 요청이 여기서 멈추고 업스트림으로 넘어가지 않는다 (Caddyfile은 선언 순서대로 미들웨어 체인을 만든다).
	# /actuator/health 만 예외로 통과시키고 /actuator/info 를 포함한 나머지 /actuator/* 는 전부 차단한다 (D-20).
	@blocked-actuator {
		path /actuator/*
		not path /actuator/health
	}
	respond @blocked-actuator 404

	reverse_proxy app:8080
}
