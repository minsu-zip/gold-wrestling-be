# 운영 리버스 프록시 (INFRA-04, 07-CONTEXT D-19, D-174) — 07-03-PLAN.md
# 표기: D-1xx = docs/decisions.md 전역 결정 / 07-CONTEXT D-xx = .planning/phases/07-container-server-setup/07-CONTEXT.md 로컬 결정(실행 맥락, 스펙 아님)
#
# 서버 배치 경로: /opt/gold-wrestling/Caddyfile (07-CONTEXT D-18)
# {$DOMAIN}/{$ACME_EMAIL} 은 서버의 .env 에서만 실값이 채워진다. 이 파일 자체에는 실도메인·실이메일을
# 절대 하드코딩하지 않는다.
# 두 변수 모두 "빈 문자열"이면 Caddyfile 파싱이 실패한다(실측: email 인자 없음 / 빈 사이트 주소 블록). 값 검사는
# 이 파일이 아니라 compose.prod.yml 의 ${VAR:?메시지} 가드가 up 시점에 한다 (D-177) — Caddyfile 에는 조건문이 없다.
# ============================================================================
{
	email {$ACME_EMAIL}
}

# {$DOMAIN:localhost} — DOMAIN 이 "아예 설정되지 않은" 경우(예: docker run 으로 caddy validate 만 할 때)만 localhost 로
# 떨어진다. 빈 문자열로 설정된 경우에는 이 기본값이 적용되지 않는다(07-03 실측) — compose 경로는 D-177 가드가 막는다 (07-CONTEXT D-05/D-19).
# 사이트 주소에 http:// 접두를 붙이지 않는다 — 붙이면 자동 HTTPS(및 80→443 리다이렉트)가 꺼진다.
# 호스트가 있는 사이트 주소는 그 자체로 자동 HTTPS가 기본 동작이라 별도 auto_https 지시어를 켜지 않는다.
# (설정이 없는 것 자체가 의도다 — 나중에 "왜 없지?"라고 의심하지 말 것)
{$DOMAIN:localhost} {
	# respond 가 reverse_proxy 보다 먼저 실행돼 이 경로의 요청이 여기서 끊기고 업스트림으로 가지 않는다.
	# 근거는 "파일에 적은 순서"가 아니다 — Caddyfile 지시어는 Caddy 에 하드코딩된 기본 순서표(docs/caddyfile/directives
	# "Directive order": … respond → metrics → reverse_proxy …)대로 정렬되며, 두 지시어를 바꿔 적어도 caddy adapt 결과가
	# 동일함을 실측했다. 순서를 파일대로 강제하려면 route 블록이나 order 전역 옵션이 필요하다. 나중에 header 처럼 기본
	# 순서상 앞에 오는 지시어를 추가할 때 "아래에 썼으니 나중에 실행된다"고 기대하지 말 것.
	# /actuator/health 만 예외로 통과시키고 /actuator/info 를 포함한 나머지 /actuator/* 는 전부 차단한다 (D-174).
	@blocked-actuator {
		path /actuator/*
		not path /actuator/health
	}
	respond @blocked-actuator 404

	reverse_proxy app:8080
}
